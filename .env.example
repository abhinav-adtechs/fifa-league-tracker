# Supabase (optional) — shared league state across devices.
# Without these, the app keeps all data in this browser's localStorage.
# vite.config.ts inlines these values into the client bundle at build time,
# so only ever use the anon (public) key here — never the service-role key.
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are accepted as aliases.

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
